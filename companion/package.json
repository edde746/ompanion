{
  "name": "ompanion-companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build src/index.ts --target=bun --format=esm --outfile dist/ompx.js --external '@oh-my-pi/*'",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:e2e": "bun run build && bun test --path-ignore-patterns='node_modules/**' --timeout=60000 e2e"
  },
  "devDependencies": {
    "@oh-my-pi/pi-agent-core": "18.4.12",
    "@oh-my-pi/pi-ai": "18.4.12",
    "@oh-my-pi/pi-catalog": "18.4.12",
    "@oh-my-pi/pi-coding-agent": "18.4.12",
    "@oh-my-pi/pi-natives": "18.4.12",
    "@oh-my-pi/pi-tui": "18.4.12",
    "@oh-my-pi/pi-utils": "18.4.12",
    "@types/bun": "1.4.2",
    "typescript": "5.9.3"
  }
}
