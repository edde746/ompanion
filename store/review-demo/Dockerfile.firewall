# Owner of the review host's network namespace: it publishes the SSH port and applies firewall.sh. It runs
# with NET_ADMIN as its only capability; the `host` container joins its network namespace with none, so
# nothing the reviewer runs can change the rules.
FROM alpine:3.22

RUN apk add --no-cache iptables ip6tables
COPY store/review-demo/firewall.sh /usr/local/bin/firewall.sh
RUN chmod 755 /usr/local/bin/firewall.sh

ENTRYPOINT ["/usr/local/bin/firewall.sh"]
