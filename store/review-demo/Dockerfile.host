# The SSH host of the ompanion review demo: Ubuntu, OpenSSH, omp 18.3.1 and the image's template home.
# Nothing in it runs as root. sshd runs as the unprivileged `review` user (see sshd_config: password
# authentication against the hash in /etc/passwd, which needs neither root nor /etc/shadow), the home and
# the host keys live in the /data volume, and the root filesystem is read-only (docker-compose.yml).
FROM ubuntu:24.04

# From .env, written by setup.sh. Only the hash reaches the image: the `review` field in /etc/passwd
# holds it.
ARG REVIEW_PASSWORD

RUN set -eu; \
    if [ -z "$REVIEW_PASSWORD" ]; then echo "REVIEW_PASSWORD build arg is empty: run setup.sh first" >&2; exit 1; fi; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
      git \
      locales \
      openssh-server \
      openssl; \
    rm -rf /var/lib/apt/lists/*; \
    # SSH forwards the client's LANG/LC_* (AcceptEnv): without the locale, every session starts with
    # "setlocale: cannot change locale". C.UTF-8 is built in; en_US.UTF-8 needs generating.
    printf 'en_US.UTF-8 UTF-8\n' >/etc/locale.gen; \
    locale-gen >/dev/null; \
    if command -v sudo >/dev/null 2>&1; then echo "sudo must not be installed" >&2; exit 1; fi; \
    useradd --create-home --home-dir /data/review --shell /bin/bash review; \
    install -d -o review -g review -m 755 /data /data/review; \
    sed -i '/^HostKey /d' /etc/ssh/sshd_config; \
    rm -f /etc/ssh/ssh_host_*; \
    field=$(awk -F: '$1 == "review" { print $2 }' /etc/passwd); \
    if [ "$field" != "x" ]; then echo "unexpected password field for review: $field" >&2; exit 1; fi; \
    hash=$(openssl passwd -6 "$REVIEW_PASSWORD"); \
    awk -v h="$hash" -F: 'BEGIN { OFS = ":" } $1 == "review" { $2 = h } { print }' /etc/passwd >/etc/passwd.new; \
    cat /etc/passwd.new >/etc/passwd; \
    rm /etc/passwd.new

# omp comes from the repository's own fetcher, so the checksum verification has one implementation
# (scripts/fetch_omp.sh checks the asset against the release's SHA256SUMS.txt). The image is built for the
# VPS's architecture, so the script downloads that architecture's asset. It keeps its scripts/ layout
# because it writes under `<repository>/.tools/`, which is /opt/review-build here.
COPY scripts/fetch_omp.sh /opt/review-build/scripts/fetch_omp.sh
RUN set -eu; \
    case "$(uname -m)" in \
      x86_64) target=linux-x64 ;; \
      aarch64 | arm64) target=linux-arm64 ;; \
      *) echo "omp has no Linux build for $(uname -m)" >&2; exit 1 ;; \
    esac; \
    /opt/review-build/scripts/fetch_omp.sh "$target"; \
    mkdir -p /opt/omp; \
    cp "/opt/review-build/.tools/omp/"*"/omp-$target" /opt/omp/omp; \
    chmod 755 /opt/omp/omp; \
    /opt/omp/omp --version; \
    rm -rf /opt/review-build

# The template home (omp's config, the demo project, shell startup files) and the scripts the entrypoint
# and the reset command run. Their content is documented in store/review-demo/README.md.
COPY store/review-demo/sshd_config /etc/ssh/sshd_config.d/00-review.conf
COPY store/review-demo/entrypoint.sh store/review-demo/restore-home.sh /usr/local/bin/
COPY store/review-demo/home-template/ /opt/review-demo/home/

# The demo project's git history is written here rather than committed to ompanion's repository: fixed
# authors, fixed dates, so the same source files always produce the same history.
RUN set -eu; \
    mkdir -p /opt/review-demo/home/.local/bin; \
    ln -s /opt/omp/omp /opt/review-demo/home/.local/bin/omp; \
    cd /opt/review-demo/home/work/notes-api; \
    git init -q -b main; \
    git config user.name "ompanion demo"; \
    git config user.email "demo@example.com"; \
    git add package.json tsconfig.json .gitignore .editorconfig; \
    GIT_AUTHOR_DATE="2026-09-10T09:00:00Z" GIT_COMMITTER_DATE="2026-09-10T09:00:00Z" \
      git commit -q -m "chore: scaffold the notes service"; \
    git add src; \
    GIT_AUTHOR_DATE="2026-09-15T14:30:00Z" GIT_COMMITTER_DATE="2026-09-15T14:30:00Z" \
      git commit -q -m "feat: serve notes over HTTP"; \
    git add README.md docs CHANGELOG.md; \
    GIT_AUTHOR_DATE="2026-09-20T11:00:00Z" GIT_COMMITTER_DATE="2026-09-20T11:00:00Z" \
      git commit -q -m "docs: readme, api notes and changelog"; \
    git reflog expire --expire=now --all; \
    git gc -q --prune=now; \
    chown -R review:review /opt/review-demo/home; \
    find /opt/review-demo/home -type d -exec chmod 755 {} +; \
    find /opt/review-demo/home -type f -exec chmod 644 {} +; \
    chmod 755 /usr/local/bin/entrypoint.sh /usr/local/bin/restore-home.sh

USER review
ENV HOME=/data/review
EXPOSE 2222
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
