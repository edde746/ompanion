        "name": "OMP_AUTH_BROKER_TOKEN",
        "fallback": false
      }
    },
    {
      "path": "enabledModels",
      "type": "array",
      "default": [],
      "isCredential": false,
      "pathScoped": {
        "valuesKey": "models"
      }
    },
    {
      "path": "modelRoleStorage",
      "type": "enum",
      "default": "global",
      "isCredential": false,
      "enumValues": [
        "global",
        "project"
      ],
      "ui": {
        "tab": "model",
        "group": "Prompt",
        "label": "Model Role Storage",
        "description": "Where model selector role assignments are saved",
        "options": [
          {
            "value": "global",
            "label": "Global",
            "description": "Save role models in the active profile config (current behavior)"
          },
          {
            "value": "project",
            "label": "Per-project",
            "description": "Save project role models in .omp/config.yml; missing project roles use global defaults"
          }
        ]
      }
    },
    {
      "path": "modelRoles",
      "type": "record",
      "default": {},
      "isCredential": false
    },
    {
      "path": "autoResume",
