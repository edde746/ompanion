      }
    },
    {
      "path": "mnemopi.embeddingApiKey",
      "type": "string",
      "default": null,
      "isCredential": true,
      "ui": {
        "tab": "memory",
        "group": "Mnemopi",
        "label": "Mnemopi Embedding API Key",
        "description": "Optional embedding API key passed to Mnemopi",
        "condition": "mnemopiActive"
      }
    },
