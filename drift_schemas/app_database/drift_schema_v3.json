  "fixed_sql": [
    {
      "name": "ssh_keys",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"ssh_keys\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"type\" TEXT NOT NULL, \"public_key\" TEXT NOT NULL, \"fingerprint\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "machines",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"machines\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"host\" TEXT NULL, \"port\" INTEGER NOT NULL DEFAULT 22, \"user\" TEXT NULL, \"auth\" TEXT NULL, \"key_id\" TEXT NULL REFERENCES ssh_keys (id) ON DELETE SET NULL, \"ssh_config_alias\" TEXT NULL, \"tailscale\" INTEGER NOT NULL DEFAULT 0 CHECK (\"tailscale\" IN (0, 1)), \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "machine_jumps",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"machine_jumps\" (\"id\" TEXT NOT NULL, \"machine_id\" TEXT NOT NULL REFERENCES machines (id) ON DELETE CASCADE, \"position\" INTEGER NOT NULL, \"host\" TEXT NOT NULL, \"port\" INTEGER NOT NULL DEFAULT 22, \"user\" TEXT NOT NULL, \"auth\" TEXT NOT NULL, \"key_id\" TEXT NULL REFERENCES ssh_keys (id) ON DELETE SET NULL, PRIMARY KEY (\"id\"), UNIQUE (\"machine_id\", \"position\"));"
        }
      ]
    },
    {
      "name": "known_hosts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"known_hosts\" (\"host\" TEXT NOT NULL, \"port\" INTEGER NOT NULL, \"key_type\" TEXT NOT NULL, \"key_blob\" TEXT NOT NULL, \"fingerprint\" TEXT NOT NULL, \"added_at\" TEXT NOT NULL, PRIMARY KEY (\"host\", \"port\", \"key_type\"));"
        }
      ]
    },
    {
      "name": "settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "read_markers",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"read_markers\" (\"machine_id\" TEXT NOT NULL REFERENCES machines (id) ON DELETE CASCADE, \"path\" TEXT NOT NULL, \"seen_modified\" TEXT NOT NULL, PRIMARY KEY (\"machine_id\", \"path\"));"
        }
      ]
    },
    {
      "name": "pinned_sessions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"pinned_sessions\" (\"machine_id\" TEXT NOT NULL REFERENCES machines (id) ON DELETE CASCADE, \"session_id\" TEXT NOT NULL, \"path\" TEXT NOT NULL, \"cwd\" TEXT NOT NULL, \"title\" TEXT NULL, \"first_message\" TEXT NULL, \"pinned_at\" TEXT NOT NULL, PRIMARY KEY (\"machine_id\", \"session_id\"));"
        }
      ]
    }
  ]
