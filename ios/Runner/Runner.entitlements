<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>development</string>
	<!-- Keychain items saved without a group go to the first group, so it stays the app's own group, where
	     flutter_secure_storage keeps its items. The Notification Service Extension shares the second one, which holds
	     the push key alone. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.edde746.ompanion</string>
		<string>$(AppIdentifierPrefix)com.edde746.ompanion.push</string>
	</array>
</dict>
</plist>
