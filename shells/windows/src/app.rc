// The exe's icon (shells/windows/resources, found through the include path CMakeLists.txt sets), manifest and
// version.
#include <windows.h>

#define TEXT_OF_(x) #x
#define TEXT_OF(x) TEXT_OF_(x)

// The lowest id: Explorer and the taskbar show the first icon.
1 ICON "app_icon.ico"

// 24: RT_MANIFEST.
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION APP_VERSION_NUMBER
PRODUCTVERSION APP_VERSION_NUMBER
FILEOS VOS__WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "com.edde746"
            VALUE "FileDescription", "ompanion"
            VALUE "FileVersion", TEXT_OF(APP_VERSION)
            VALUE "InternalName", "ompanion"
            VALUE "LegalCopyright", "Copyright (C) 2026 com.edde746. All rights reserved."
            VALUE "OriginalFilename", "ompanion.exe"
            VALUE "ProductName", "ompanion"
            VALUE "ProductVersion", TEXT_OF(APP_VERSION)
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
